{
  "name": "wolves-web-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "start": "npm run start --workspace apps/web",
    "build": "node scripts/build-web.cjs build",
    "build:prod": "node scripts/build-web.cjs build:prod",
    "clean": "node scripts/build-web.cjs clean",
    "compile": "npm run compile --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "format:check": "npm run format:check --workspace apps/web",
    "styles": "npm run styles --workspace apps/web",
    "check": "npm run check --workspaces",
    "test": "npm run test --workspace apps/web",
    "dev": "concurrently -k \"npm start\" \"npm run dev --workspace apps/api\"",
    "backend:local": "npm run db:migrate --workspace apps/api && npm run dev --workspace apps/api",
    "backend:tunnel": "cloudflared tunnel --url http://localhost:8787 --protocol http2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "@brojs/i18nextreactconfig": {
      "react-i18next": {
        "typescript": "^7.0.2"
      }
    }
  }
}
