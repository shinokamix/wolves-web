{
  "compilerOptions": {
    "target": "ES2020", "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext", "moduleResolution": "bundler", "jsx": "react",
    "rootDir": "./src", "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "strict": true, "resolveJsonModule": true,
    "types": ["webpack-env", "node"], "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
