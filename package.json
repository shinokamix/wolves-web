{
  "name": "wolves-web",
  "version": "0.0.0",
  "description": "",
  "main": "./src/index.tsx",
  "scripts": {
    "start": "npm run styles && concurrently -k \"npm run styles:watch\" \"brojs server --port=8099\"",
    "build": "npm run clean && npm run styles && brojs build --dev",
    "build:prod": "npm run clean && npm run styles && brojs build",
    "clean": "rimraf dist",
    "compile": "npm run styles && brojs compile",
    "prom": "npm run compile && brojs prom-server --port=8099",
    "lint": "oxlint --type-aware src",
    "lint:fix": "oxlint --type-aware --fix src",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check": "npm run check:web && npm --prefix agent run check",
    "dev": "concurrently -k \"npm start\" \"npm --prefix agent run dev\"",
    "styles": "tailwindcss -i src/styles.css -o src/generated/styles.css --minify",
    "styles:watch": "tailwindcss -i src/styles.css -o src/generated/styles.css --watch",
    "check:web": "npm run format:check && npm run lint && npm run typecheck",
    "test": "vitest run && npm --prefix agent test",
    "setup": "npm ci && npm --prefix agent ci"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@brojs/cli": "^2.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.17",
    "@react-google-maps/api": "^2.20.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react-globe.gl": "^2.38.0",
    "tailwind-merge": "^3.6.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react-router-dom": "^6.30.1",
    "@radix-ui/react-slot": "^1.2.4"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "tailwindcss": "^4.3.3",
    "@types/three": "^0.185.1",
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^9.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react-i18next": {
      "typescript": "$typescript"
    }
  }
}
