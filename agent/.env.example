PORT=8787
FRONTEND_URL=http://localhost:8099/wolves-web
DATABASE_URL=postgresql://travel:travel@localhost:5432/travel?schema=public
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Enable for a frontend on another site calling an HTTPS API:
AUTH_CROSS_SITE_COOKIES=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Optional alternative OpenAI-compatible provider:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=
GOOGLE_MAPS_API_KEY=
UPLOADTHING_TOKEN=
# Optional OAuth. Callback: http://localhost:8787/api/auth/callback/<provider>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Enable only behind one trusted reverse proxy:
# TRUST_PROXY=1
