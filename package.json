{
  "name": "wolves-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix apps/web ci",
    "start": "npm --prefix apps/web start",
    "build": "node scripts/build-web.cjs build",
    "build:prod": "node scripts/build-web.cjs build:prod",
    "clean": "node scripts/build-web.cjs clean",
    "compile": "npm --prefix apps/web run compile",
    "prom": "npm --prefix apps/web run prom",
    "lint": "npm --prefix apps/web run lint",
    "lint:fix": "npm --prefix apps/web run lint:fix",
    "typecheck": "npm --prefix apps/web run typecheck",
    "format": "npm --prefix apps/web run format",
    "format:check": "npm --prefix apps/web run format:check",
    "styles": "npm --prefix apps/web run styles",
    "styles:watch": "npm --prefix apps/web run styles:watch",
    "check:web": "npm --prefix apps/web run check",
    "check": "npm run check:web && npm --prefix apps/agent run check",
    "test": "npm --prefix apps/web test && npm --prefix apps/agent test",
    "setup": "npm ci && npm --prefix apps/agent ci",
    "dev": "npm --prefix apps/web exec --offline -- concurrently -k \"npm start\" \"npm --prefix apps/agent run dev\"",
    "backend:local": "npm --prefix apps/agent run db:migrate && npm --prefix apps/agent run dev",
    "backend:tunnel": "cloudflared tunnel --url http://localhost:8787 --protocol http2"
  }
}
